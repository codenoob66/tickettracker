<?xml version="1.0" encoding="UTF-8"?>
<!-- Ticket Tracker — IIS fallback. Apache/LiteSpeed ignores this file. -->
<!-- Blocks direct downloads of tickets.db and the auth/setup scripts. -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="tickets.db" />
          <add segment="auth_config.php" />
          <add segment="setup_password.php" />
          <add segment=".htaccess" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".db" allowed="false" />
          <add fileExtension=".db-journal" allowed="false" />
          <add fileExtension=".db-wal" allowed="false" />
          <add fileExtension=".db-shm" allowed="false" />
          <add fileExtension=".sqlite" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="same-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
